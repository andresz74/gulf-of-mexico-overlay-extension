{
  "manifest_version": 3,
  "name": "Gulf of Mexico Overlay",
  "version": "1.0.0",
  "description": "Replace “Gulf of America” with “Gulf of Mexico” everywhere on Google Maps and overlay a custom label.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*"
  ],
  "action": {
    "default_title": "Gulf of Mexico Overlay",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
